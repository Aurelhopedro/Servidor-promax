# ══════════════════════════════════════════════════════════════════════════
# MCP AGREGADOR — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores reais.
# NUNCA faças commit do .env para o repositório.
# ══════════════════════════════════════════════════════════════════════════

# ── Segurança ──────────────────────────────────────────────────────────────
# Chave secreta que os clientes MCP devem enviar como Bearer token.
# Gera um valor seguro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=

# Segredo partilhado com o n8n para validar as assinaturas HMAC dos callbacks.
# Configura o mesmo valor nas definições do teu workflow n8n (Credential → Header Auth).
# Gera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_CALLBACK_SECRET=

# Rate limiting (opcional — valores por defeito: 60 req/min)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000

# ── Orquestrador ───────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=https://3d.up.railway.app/webhook/SEU-WEBHOOK-ID
# URL pública do callback HTTP (Render/Railway/Vercel)
MCP_CALLBACK_URL=https://SEU-PROJETO.onrender.com/callback

# ── Deploy ─────────────────────────────────────────────────────────────────
# URL pública do servidor (preenchida automaticamente pelo Render)
# RENDER_EXTERNAL_URL=https://servidor-promax.onrender.com

# ── Supabase (persistência de tarefas) ────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── GitHub (equipa code) ──────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── Groq (AI workers) ─────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Facebook / Meta (equipa social/publishing) ────────────────────────────
META_ACCESS_TOKEN=EAA...
META_PAGE_ID=1021090224430866
META_APP_ID=
META_APP_SECRET=

# ── Notion (equipa content) ───────────────────────────────────────────────
NOTION_TOKEN=secret_...

# ── Cloudinary (media) ────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://...

# ── Brevo ─────────────────────────────────────────────────────────────────
BREVO_API_KEY=

# ── HubSpot ───────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=

# ── ElevenLabs ────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Stability AI ──────────────────────────────────────────────────────────
STABILITY_API_KEY=

# ── SerpAPI ───────────────────────────────────────────────────────────────
SERPAPI_KEY=

# ── Tavily ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── WordPress ─────────────────────────────────────────────────────────────
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# ── Ghost ─────────────────────────────────────────────────────────────────
GHOST_URL=
GHOST_ADMIN_API_KEY=

# ── QStash ────────────────────────────────────────────────────────────────
QSTASH_TOKEN=

# ── Medium ────────────────────────────────────────────────────────────────
MEDIUM_TOKEN=

# ── Brave Search ──────────────────────────────────────────────────────────
BRAVE_API_KEY=

# ── Mistral ───────────────────────────────────────────────────────────────
MISTRAL_API_KEY=

# ── Replicate ─────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=

# ── E2B (sandboxes) ───────────────────────────────────────────────────────
E2B_API_KEY=

# ── SonarQube ─────────────────────────────────────────────────────────────
SONARQUBE_URL=
SONARQUBE_TOKEN=

# ── Shotstack ─────────────────────────────────────────────────────────────
SHOTSTACK_API_KEY=

# ── Creatomate ────────────────────────────────────────────────────────────
CREATOMATE_API_KEY=
