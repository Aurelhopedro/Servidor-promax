{
  "name": "mcp-agregador",
  "version": "1.0.0",
  "description": "MCP Agregador — 1 Mensagem, Máximo Retorno. Orquestra tarefas entre Claude, n8n e múltiplas equipas de execução.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/api/mcp.ts",
    "build": "tsc",
    "build:vercel": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "claude",
    "n8n",
    "automation",
    "aggregator"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.7.15",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
